/target

# corpus acquisition raw-fetch cache (data, not source — regenerable).
# Split on disk by trust: raw/ship/ is verified ship-safe material; raw/reference/
# is downloaded-for-inspection only and must never be shipped. Both are gitignored.
/corpus/raw/

# vector-store artifacts (regenerable; never commit — may contain ingested corpus)
/*.db
/*.db-shm
/*.db-wal
/monomyth.db*

# poly (polylint) cache
/.polylint/

# LLM provider secrets (copied from xberg-io) — never commit
/.env

# ADR-0016 pre-review synthesis candidates; promoted into artifacts/laws/ by hand
/synthesis/

# OS
.DS_Store

# BEGIN ai-rulez (DO NOT EDIT - managed by ai-rulez)
.ai-rulez/.generated-manifest.json
.claude/
.codex/
.mcp.json
AGENTS.md
CLAUDE.md
# END ai-rulez

# basemind index cache (regenerable; the committed basemind.toml is the source of truth)
.basemind/
poly.local.toml
