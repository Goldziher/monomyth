{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://monomyth/artifacts/frameworks.schema.json",
  "title": "monomyth framework artifact",
  "description": "Common envelope for every artifacts/frameworks/*.json file (frameworks, taxonomy roots, and crosswalks).",
  "type": "object",
  "required": ["framework", "title", "source", "license", "namespace", "domain", "count", "items"],
  "properties": {
    "framework": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "title": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "namespace": { "enum": ["ship", "reference"] },
    "domain": { "type": "string" },
    "tier_note": { "type": "string" },
    "count": { "type": "integer", "minimum": 1 },
    "reference_map": {
      "type": "object",
      "description": "Maps an item field name (ending _id or _ids) to the framework file whose item ids it references.",
      "additionalProperties": { "type": "string" }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
